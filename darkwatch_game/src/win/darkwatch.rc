#include <winver.h>
1 ICON "res/darkwatch.ico"
1 24 "res/darkwatch.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Darkwatch (static recompilation)"
      VALUE "ProductName", "Darkwatch Recompiled"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

/* Launcher fonts (SIL Open Font License, see res/fonts) */
101 RCDATA "res/fonts/Cinzel.ttf"
102 RCDATA "res/fonts/Lato-Regular.ttf"
103 RCDATA "res/fonts/Lato-Bold.ttf"
104 RCDATA "res/fonts/Lato-Black.ttf"
